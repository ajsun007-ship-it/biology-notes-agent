# Production URL of your n8n Webhook node (use the /webhook-test/... URL while testing in the n8n editor)
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/biology-notes

# HTTP method of your n8n Webhook node: POST (recommended, supports PDF/DOCX) or GET (text only, query params)
N8N_WEBHOOK_METHOD=POST

# Optional: sent as a header so your n8n webhook can use Header Auth
N8N_AUTH_HEADER_NAME=
N8N_AUTH_HEADER_VALUE=

# Port for this web app
PORT=3000

# Max upload size in MB and agent timeout in seconds
MAX_FILE_MB=10
AGENT_TIMEOUT_SECONDS=120
