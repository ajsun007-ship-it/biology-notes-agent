# Production URL of your n8n Webhook node (use the /webhook-test/... URL while testing in the n8n editor)
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/biology-notes

# HTTP method of your n8n Webhook node: POST (recommended, supports PDF/DOCX) or GET (text only, query params)
N8N_WEBHOOK_METHOD=POST

# Optional: sent as a header so your n8n webhook can use Header Auth
N8N_AUTH_HEADER_NAME=
N8N_AUTH_HEADER_VALUE=

# Port for this web app
PORT=3000

# Max upload size in MB and agent timeout in seconds
MAX_FILE_MB=10
AGENT_TIMEOUT_SECONDS=180

# --- Podcast voices (optional) ---
# With an OpenAI API key, podcasts are recorded as an MP3 with two realistic voices.
# Without it, the page reads the script aloud using the browser's built-in voices (free).
OPENAI_API_KEY=
# TTS_MODEL=gpt-4o-mini-tts      # or tts-1
# Voices: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse
# Preview voices + styles for free at https://www.openai.fm
# TTS_VOICE_ALEX=ash
# TTS_VOICE_SAM=sage
# Delivery directions (gpt-4o-mini-tts only), written in plain English:
# TTS_STYLE_SAM=The warm, rich voice of a beloved daytime talk-show host. Unhurried, expressive, inspiring.
# TTS_STYLE_ALEX=Upbeat, curious co-host. Natural and conversational.
